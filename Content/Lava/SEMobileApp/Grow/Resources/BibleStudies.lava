{%- capture bsq -%}\"{%- endcapture -%}
{% interactionwrite channeltypemediumvalueid:'45691' channelname:'Subsplash App' componententitytypeid:'31' componentname:'Grow Bible Studies' componententityid:'31003' operation:'View' summary:'Grow Bible Studies Page' personaliasid:'{{ CurrentPerson.PrimaryAliasId }}'%}
Grow Bible Studies Page
{% endinteractionwrite %}
{
	"header": {
		"title": "Bible Studies"
	},
	"displayOptions":{
		"style":"rows",
		"contentWidthRatio":0.9,
	    "itemDisplayOptions":{
	        "indicatorAspectRatio":1,
	        "indicatorShadowEnabled":true,
	        "maxWidth":640,
	        "textPosition":"below"
	    },
		"colors":{
	        "brand":{
	            "primary":"#121212",
	            "primaryAccent":"#FFFFFF"
	        },
	        "theme":{
	            "primary":"#121212",
	            "primaryAccent":"#FFFFFF"
	        },
	        "topBar":{
	            "primary":"#121212",
	            "primaryAccent":"#FFFFFF"
	        },
	        "bottomBar":{
	            "primary":"#121212",
	            "primaryAccent":"#FFFFFF"
	        },
	        "brandableElements":""
	    }
	},
	"items": [
        {% contentchannelitem where:'ContentChannelId == 45' sort:'Order desc' %}
            {%- assign hasOutput = false -%}
            {% for item in contentchannelitemItems %}
                {%- assign nowDateTime = 'Now' | Date:'yyyyMMddHHmmss' -%}
                {%- assign startDateTime = item.StartDateTime | Date:'yyyyMMddHHmmss' -%}
                {%- assign endDateTime = item.ExpireDateTime | Date:'yyyyMMddHHmmss' | Default:'99999999999999' -%}
                {%- assign readingPlanURL = item | Attribute:'YouVersionPlanUrl','RawValue' -%}
                {%- if startDateTime <= nowDateTime and nowDateTime <= endDateTime -%}
                    {%- assign title = item.Title | Replace:'"',bsq -%}
                    {%- assign imgGuid = item | Attribute:'SquarePodcastImage','RawValue' -%}
                    {%- if imgGuid == '' -%}{%- assign imgGuid = item | Attribute:'Image','RawValue' -%}{%- endif -%}
                    {%- assign daysInPlan = item | Attribute:'DaysinPlan','RawValue' -%}
                    {%- if hasOutput -%},{%- endif -%}
                    {%- assign hasOutput = true -%}
                    {
                        {%- if imgGuid != '' -%}
                        "images":[
                            {"width": 640,
                            "url":"{{ 'Global' | Attribute:'MobileApplicationRoot' }}GetImage.ashx/{{ imgGuid }}.jpg?guid={{ imgGuid }}&width=640&height=640&mode=crop"}
                        ],
                        {%- endif -%}
                        {%- if daysInPlan != '' -%}"subtitle": "{{ daysInPlan }} Days",{%- endif -%}
                        "title": "{{ title }}",
                        "actions":[{
                            "handler":"browser",
                            "style":"external",
                            "type":"navigation",
                            "showBrowserControls": true,
                            "contentUrl": "{{ 'Global' | Attribute:'PublicApplicationRoot' }}resources/bible-studies/{{ item.PrimarySlug }}"
                        }]
                    }
                {%- endif -%}
            {% endfor %}
        {% endcontentchannelitem %}
	]
}
