{%- capture bsq -%}\"{%- endcapture -%}
{% interactionwrite channeltypemediumvalueid:'45691' channelname:'Subsplash App' componententitytypeid:'31' componentname:'Grow Sermon Study Guides' componententityid:'31182' operation:'View' summary:'Grow Sermon Study Guides Page' personaliasid:'{{ CurrentPerson.PrimaryAliasId }}'%}
Grow Sermon Study Guides Page
{% endinteractionwrite %}
{
	"header": {
		"title": "Sermon Study Guides"
	},
	"displayOptions":{
		"style":"rows",
		"contentWidthRatio":0.9,
	    "itemDisplayOptions":{
	        "indicatorAspectRatio":1,
	        "indicatorShadowEnabled":true,
	        "maxWidth":640,
	        "textPosition":"below"
	    },
		"colors":{
	        "brand":{
	            "primary":"#121212",
	            "primaryAccent":"#FFFFFF"
	        },
	        "theme":{
	            "primary":"#121212",
	            "primaryAccent":"#FFFFFF"
	        },
	        "topBar":{
	            "primary":"#121212",
	            "primaryAccent":"#FFFFFF"
	        },
	        "bottomBar":{
	            "primary":"#121212",
	            "primaryAccent":"#FFFFFF"
	        },
	        "brandableElements":""
	    }
	},
	"items": [
        {%- contentchannelitem where:'ContentChannelId == 24' sort:'StartDateTime desc' offset:'{{offset}}' limit:'120'  -%}
			{%- assign hasOutput = false -%}
            {%- for series in contentchannelitemItems -%}
	        	{%- assign itemActionHandler = "list" -%}
				{%- assign itemActionUrl = 'Global' |  Attribute:'MobileApplicationRoot' | Append:'api/subsplash/webhook/sermons/series/' | Append:series.Id -%}
				{%- assign resourcesCount = 0 -%}
				{%- assign itemChildItems = series.ChildItems | Sort:'Order' -%}
				{%- for messages in itemChildItems -%}
					{%- assign message = messages.ChildContentChannelItem -%}
					{%- if message.ContentChannelId != "23" -%}
						{%- assign resourcesCount = resourcesCount | Plus:1 -%}
					{%- endif -%}
				{%- endfor -%}
				{%- if resourcesCount != 0 -%}
					{%- if hasOutput -%},{%- endif -%}
            		{%- assign hasOutput = true -%}
					{%- assign itemActionHandler = "subtabs" -%}
					{%- assign itemActionUrl = 'Global' |  Attribute:'MobileApplicationRoot' | Append:'api/subsplash/webhook/tabs/series/' | Append:series.Id | Append:'/resources' -%}
					{
						"title": "{{-series.Title | Replace:'"',bsq -}}",
						"subtitle": "{{- series.Content  | Replace:'"',bsq  | UrlEncode | Replace:'%0A','' | UrlDecode  -}}",
						{%- assign imgGuid = series | Attribute:'SquarePodcastImage','RawValue' -%}
						{%- if imgGuid == '' -%}{%- assign imgGuid = series | Attribute:'Image','RawValue' -%}{%- endif -%}
						{%- if imgGuid != '' -%}
						"images":[{
							"width": 640,
							"url":"{{ 'Global' | Attribute:'MobileApplicationRoot' }}GetImage.ashx/{{ imgGuid }}.jpg?guid={{ imgGuid }}&width=640&height=640&mode=crop"
						}],
						{%- endif -%}
						"actions": [{
							"handler": "{{- itemActionHandler -}}",
		            		{%- if itemActionHandler == "subtabs" -%}"type": "navigation",{%- endif -%}
							"url": "{{- itemActionUrl -}}"
						}]
					}
				{%- endif -%}
            {%- endfor -%}
        {% endcontentchannelitem %}
	]
}
