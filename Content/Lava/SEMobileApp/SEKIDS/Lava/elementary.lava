{
    "blocks": [
        {%- contentchannelitem where:'ContentChannelId == 94' -%}
		    {%- assign itemsSorted = contentchannelitemItems | Sort:"Order" -%}
            {%- assign count = 0 -%}
            {%- assign comma = "" -%}
            {%- assign nowDateTime = 'Now' | Date:'yyyyMMddHHmmss' -%}
            {%- for item in itemsSorted -%}
                {%- assign category = item | Attribute:'Category' -%}
                {% if category == "Elementary" %}

                {%- assign startDateTime = item.StartDateTime | Date:'yyyyMMddHHmmss' -%}
                {%- assign endDateTime = item.ExpireDateTime | Date:'yyyyMMddHHmmss' | Default:'99999999999999' -%}
                {%- if startDateTime <= nowDateTime and nowDateTime <= endDateTime -%}
                    {%- assign count = count | Plus:1 -%}
                    {{ comma }}
                    {%- assign hideTitle = item | Attribute:'HideTitle' | AsBoolean -%}
                    {%- assign hideDescription = item | Attribute:'HideDescription' | AsBoolean -%}
                    {%- assign imageGuid = item | Attribute:'VideoCover', 'RawValue' -%}
                    {%- assign description = item | Attribute:'Description' | StripNewlines | Replace:'\','\\' | Replace:'"','\"' -%}
                    {%- assign video = item | Attribute:'videourl','RawValue' -%}
                    {%- assign extraLinks = item | Attribute:'ExtraLinks' -%}
                    {
                        "type": "mediaBanner",
                        "props": {
                            {% if video != '' %}
                            "playlistUrl": "{{ 'Global' | Attribute:'MobileApplicationRoot' }}api/subsplash/webhook/sekids/home/biblestory/video/{{ item.Id }}",
                            {% endif %}
                            {% if imageGuid != '' %}
                            "posterImageUrl": "{{ 'Global' | Attribute:'MobileApplicationRoot' }}GetImage.ashx/{{ imageGuid }}.jpg?guid={{ imageGuid }}&bgcolor=121212&width=1200",
                            {% endif %}
                            "bannerBackgroundUrl": "",
                            "averageColor": "#121212",
                            "vibrantColor": "#121212"
                        }
                    }
                    {{ extraLinks }}
                    {% if hideTitle != true %}
                    ,{
                        "type": "text",
                        "props": {
                            "h1": true,
                            "content": "{{ item.Title }}",
                            "align": "left"
                        }
                    }
                    {% endif %}
                    {% if hideDescription != true %}
                    ,{
                        "type": "text",
                        "props": {
                            "bottomSpacing": "large",
                            "content": "{{ description }}"
                        }
                    }
                    {% endif %}
                    {%- assign comma = "," -%}

                {%- endif -%}
                {% endif %}
            {%- endfor %}
            {% if count == 0 %}
            {
                "type": "text",
                "props": {
                    "topSpacing": "large",
                    "bottomSpacing": "large",
                    "content": "There are no updates yet. Come back and check again soon!"
                }
            }
            {% endif %}
        {%- endcontentchannelitem -%}
    ]
}
