{% interactionwrite channeltypemediumvalueid:'45691' channelname:'Subsplash App' componententitytypeid:'31' componentname:'Give' componententityid:'30809' operation:'View' summary:'Give Page' personaliasid:'{{ CurrentPerson.PrimaryAliasId }}'%}
Give Page
{% endinteractionwrite %}
{%- assign givingLink = 'https://pushpay.com/pay/southeastchristian'%}
{
  "blocks": [

			{
			"type": "browser",
			"props": {
				"url": "https://app.secc.org/Content/Lava/SEMobileApp/Give/Give.html",
				"actionDispatch": true,
				"height": 1
			}
			},
			{
				"type":"text",
				"props": {
					"align":"center",
					"expandable": false,
					"topSpacing": "xxl",
					"bottomwSpacing": "xxl",
					"content": "God is using your generosity\nto make a difference.",
					"h1": true
				}
			},
			{
				"type":"button",
				"props": {
					"align":"center",
					"color":"#28A5BB",
					"width": "content",
					"title": "Give now",
					"topSpacing": "xxl",
					"bottomwSpacing": "xxl",
					"action": {
							"handler": "browser",
							"style": "external",
							"contentUrl": "{{ givingLink }}"
						}
				}
			}
		]
}
