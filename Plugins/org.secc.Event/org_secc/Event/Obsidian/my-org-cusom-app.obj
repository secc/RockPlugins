<template>
    <div>
        <NotificationBox v-if="blockError" :alertType="errorType || 'warning'">
            {{ blockError }}
        </NotificationBox>

        <my-org-custom-app
            v-if="!blockError"
            ref="host">
        </my-org-custom-app>
    </div>
</template>

<script setup lang="ts">
import { onBeforeUnmount, onMounted, ref, watch } from "vue";
import NotificationBox from "@Obsidian/Controls/notificationBox.obs";
import {
    useConfigurationValues,
    useInvokeBlockAction,
    onConfigurationValuesChanged,
    useReloadBlock
} from "@Obsidian/Utility/block";

type RockConfig = {
    title?: string;
    subtitle?: string;
    submitActionName?: string;
    errorType?: "warning" | "danger" | "info" | "success";
    errorMessage?: string;
};

type BlockActionRequest = {
    requestId: string;
    actionName: string;
    payload: {
        note: string;
    };
};

type ServerState = {
    status: "idle" | "saving" | "success" | "error";
    message?: string;
    savedNote?: string;
};

const SCRIPT_SRC = "/Plugins/org_secc/Event/Obsidian/my-org-custom-app.js?v=1";
const SCRIPT_ID = "my-org-custom-app-loader";

function ensureScriptLoaded(): Promise<void> {
    if (customElements.get("my-org-custom-app")) {
        return Promise.resolve();
    }

    const existing = document.getElementById(SCRIPT_ID) as HTMLScriptElement | null;
    if (existing) {
        return new Promise((resolve, reject) => {
            existing.addEventListener("load", () => resolve(), { once: true });
            existing.addEventListener("error", () => reject(new Error(`Failed to load ${SCRIPT_SRC}`)), { once: true });
        });
    }

    return new Promise((resolve, reject) => {
        const script = document.createElement("script");
        script.id = SCRIPT_ID;
        script.type = "module";
        script.src = SCRIPT_SRC;
        script.onload = () => resolve();
        script.onerror = () => reject(new Error(`Failed to load ${SCRIPT_SRC}`));
        document.body.appendChild(script);
    });
}

const box = useConfigurationValues<RockConfig>();
const invokeBlockAction = useInvokeBlockAction();
const reloadBlock = useReloadBlock();

const host = ref<HTMLElement | null>(null);
const blockError = ref(box.errorMessage ?? "");
const errorType = ref<RockConfig["errorType"]>(box.errorType ?? "warning");
const serverState = ref<ServerState>({ status: "idle" });

const pushPropsToElement = (): void => {
    if (!host.value) {
        return;
    }

    const rockConfig: RockConfig = {
        title: box.title ?? "My Fast Rock Block",
        subtitle: box.subtitle ?? "",
        submitActionName: box.submitActionName ?? "SaveData"
    };

    host.value.setAttribute("rock-config", JSON.stringify(rockConfig));
    host.value.setAttribute("server-state", JSON.stringify(serverState.value));
};

const onBlockAction = async (event: Event): Promise<void> => {
    const detail = (event as CustomEvent<BlockActionRequest>).detail;

    serverState.value = {
        status: "saving",
        message: `Calling ${detail.actionName}...`
    };
    pushPropsToElement();

    try {
        const response = await invokeBlockAction<Record<string, unknown>>(detail.actionName, detail.payload);

        serverState.value = {
            status: "success",
            message: "Saved successfully.",
            savedNote: (response?.note as string | undefined) ?? detail.payload.note
        };
    }
    catch (error) {
        blockError.value = error instanceof Error ? error.message : "Block action failed.";
        serverState.value = {
            status: "error",
            message: "Save failed."
        };
    }

    pushPropsToElement();
};

onMounted(async () => {
    try {
        await ensureScriptLoaded();
        pushPropsToElement();
        host.value?.addEventListener("block-action", onBlockAction as EventListener);
    }
    catch (error) {
        blockError.value = error instanceof Error ? error.message : "Unable to load web component bundle.";
    }
});

onBeforeUnmount(() => {
    host.value?.removeEventListener("block-action", onBlockAction as EventListener);
});

onConfigurationValuesChanged(() => {
    reloadBlock();
});

watch(serverState, () => pushPropsToElement(), { deep: true });
</script>
