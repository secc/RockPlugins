<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net472</TargetFramework>
    <IsPackable>false</IsPackable>
    <LangVersion>latest</LangVersion>
  </PropertyGroup>

  <!-- Resolve RockWeb the same way LinkList.Tests does: honor an explicit
       /p:RockWebPath, then probe the rock-dev-tool layout (Rock next to the
       plugin folder) and the Rock solution layout (SolutionDir). -->
  <PropertyGroup>
    <RockWebPath Condition="'$(RockWebPath)' == '' And Exists('..\..\Rock\RockWeb\Bin')">..\..\Rock\RockWeb</RockWebPath>
    <RockWebPath Condition="'$(RockWebPath)' == '' And Exists('$(SolutionDir)RockWeb\Bin')">$(SolutionDir)RockWeb</RockWebPath>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.9.0" />
    <PackageReference Include="xunit" Version="2.7.0" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.5.7" />
  </ItemGroup>

  <ItemGroup>
    <!-- The plugin's post-build event copies its files into RockWeb. An empty PostBuildEvent
         for this reference turns that off when MSBuild builds the plugin through this reference
         from the command line. Visual Studio builds the plugin as its own project, so building in
         a solution that contains it, or building the plugin on its own or from Rock.sln, copies
         them whenever Visual Studio finds the plugin out of date. After a command-line build of
         these tests, it can find the plugin up to date and skip the copy until the plugin changes
         or is rebuilt. -->
    <ProjectReference Include="..\org.secc.Authentication.csproj" AdditionalProperties="PostBuildEvent=" />
    <!-- SMSAuthentication derives from Rock's AuthenticationComponent, so the compiler needs
         Rock.dll; SMSRecords uses RockDateTime from Rock.Common. The SMSRecords tests don't touch
         a database. The Authenticate tests hash codes with BCrypt.Net and run Authenticate's SQL
         against a temporary SQL Server database (see UserLoginTestDatabase), never Rock's. -->
    <Reference Include="Rock">
      <HintPath>$(RockWebPath)\Bin\Rock.dll</HintPath>
    </Reference>
    <Reference Include="Rock.Common">
      <HintPath>$(RockWebPath)\Bin\Rock.Common.dll</HintPath>
    </Reference>
    <Reference Include="BCrypt.Net">
      <HintPath>$(RockWebPath)\Bin\BCrypt.Net.dll</HintPath>
    </Reference>
  </ItemGroup>

</Project>
