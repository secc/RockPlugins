{%- assign transactionCount = TransactionDetails | Size -%}{%- if transactionCount > 0 -%}

<style>
    thead { display: table-header-group }
    tfoot { display: table-row-group }
    tr { page-break-inside: avoid }
    p { page-break-inside: avoid }
</style>
{% assign total = 0 %}
{% assign StatementEndMonthDay = StatementEndDate | Date:'MMdd' %}
<div style="min-width: 1024px;">
	<div class="row">
		<div class="col-xs-8">
			<h1>{{ StatementStartDate | Date:'yyyy' }} {% if StatementEndMonthDay == '1231' %}Annual{% else %}Year-to-date{% endif %} Qualified Charitable Distribution Statement</h1>
    		<strong>Period</strong>: &nbsp;{{ StatementStartDate | Date:'MMM d' }} - {{ StatementEndDate | Date:'MMM d, yyyy' }}
    		{%- assign StreetAddress1 = StreetAddress1 | Trim -%}
    		{%- if StreetAddress1 != '' -%}
			<div style="margin: 150px 0px 50px 75px; font-size: 12pt;">
    			<strong>{{ Salutation | Upcase }}</strong><br />
    			{{ StreetAddress1 | Upcase  }} <br />
    			{% assign StreetAddress2 = StreetAddress2 | Trim %}{% if StreetAddress2 != '' %}
    				{{ StreetAddress2 | Upcase  }}<br />
    			{% endif %}
    			{{ City | Upcase  }}, {{ State | Upcase  }} {{ PostalCode }}
			</div>
            <br />
            <br />
            {%- else -%}
            <br /><strong>Prepared for:</strong> {{ Salutation }}
            {%- endif -%}
		</div>
		<div class="col-xs-4">
			<div class="row">
				<div class="col-xs-12 text-center">
					<div class="clearfix" style="margin: 25px">
						<img src="data:image/png;base64," alt="SE Primary Logo" width="250px"/>
					</div>
					{{ 'Global' | Attribute:'OrganizationAddress','Street1' }}<br />
					{{ 'Global' | Attribute:'OrganizationAddress','City' }}, {{ 'Global' | Attribute:'OrganizationAddress','State' }} {{ 'Global' | Attribute:'OrganizationAddress','PostalCode' }}<br />
					{{ 'Global' | Attribute:'OrganizationWebsite' }}
				</div>
			</div>
		</div>
	</div>
	<div class="row">
		<div class="col-xs-8">
			
			{% for transaction in TransactionDetails reversed %}
				{% if forloop.first %}
				<h4 class="margin-t-md margin-b-md" style="border-bottom: 2px solid black;">Qualified Charitable Distribution gifts for {{ StatementStartDate | Date:'MMM d' }} - {{ StatementEndDate | Date:'MMM d, yyyy' }}</h4>
			
			
				<table class="table table-bordered table-striped table-condensed">
					<tr>
						<th>Date</th>
						<th>Check #</th>
						<th>Financial Firm</th>
						<th>Fund</th>
						<th align="right">Amount</th>
					</tr>
				{% endif %}
				{% assign accountName = transaction.Account.PublicName %}
				{% if accountName == '' or accountName == null %}
				    {% assign accountName = transaction.Account.Name %}
				{% endif %}
                <tr>
                    <td>{{ transaction.Transaction.TransactionDateTime | Date:'M/d/yyyy' }}</td>
                    <td>
                    {%- comment -%}ROCK-9037: never fall back to the PushPay TransactionCode. Check number sources, in order: the CheckNumber attribute, then a strictly formatted 'Check #12345' transaction Summary. If neither is available, print nothing.{%- endcomment -%}
                    {%- assign checkNumber = '' -%}
                    {% for av in transaction.Transaction.AttributeValues  %}
                        {% if av.AttributeKey == 'CheckNumber' and av.Value != '' and av.Value != empty %}
                            {% assign checkNumber = av.Value %}
                            {% break %}
                        {% endif %}
                    {% endfor %}
                    {%- if checkNumber == '' -%}
                        {%- capture checkSummaryPattern -%}^\s*Check #[0-9]+\s*${%- endcapture -%}
                        {%- capture checkDigitsPattern -%}[0-9]+{%- endcapture -%}
                        {%- assign summaryMatch = transaction.Transaction.Summary | RegExMatchValue:checkSummaryPattern | Default:'' -%}
                        {%- if summaryMatch and summaryMatch != '' -%}
                            {%- assign checkNumber = summaryMatch | RegExMatchValue:checkDigitsPattern | Default:'' -%}
                        {%- endif -%}
                    {%- endif -%}
                    {% if checkNumber and checkNumber != '' %}#{{ checkNumber }}{% endif %}
                    </td>
                    <td>{{ transaction.Transaction.Summary }}</td>
                    <td>{{ accountName }}</td>
                    <td align="right">{{ transaction.Amount | FormatAsCurrency  }}</td>
                </tr>
				{% assign total = total | Plus:transaction.Amount %}

				{% if forloop.last %}
					<tfoot>
						<tr>
							<th colspan="4" class="text-right">Total contributions:</th>
							<th class="text-right">{{total| FormatAsCurrency }}</th>
						</tr>
					</tfoot>
				</table>
				{% endif %}
			{% endfor %}
		</div>
		<div class="col-xs-4">
			<h4 class="margin-t-md margin-b-md" style="border-bottom: 2px solid black;">Giving Summary</h4>
            <table border="0" cellpadding="2" cellspacing="0" width="100%" style="margin-bottom:10px;">
			{% for accountsummary in AccountSummary %}
			    {% assign summaryAccountName = accountsummary.PublicName %}
			    {% if summaryAccountName == '' or summaryAccountName == null %}
			        {% assign summaryAccountName = accountsummary.AccountName %}
			    {% endif %}
			    <tr>
			        <td style="text-indent:-20px;padding-left:20px;"><strong>{{ summaryAccountName }}</strong></td>
			        <td align="right" valign="bottom"><strong>{{ accountsummary.Total | FormatAsCurrency  }}</strong></td>
			    </tr>
			 {% endfor %}
			 </table>
			 <div style="border: 1px solid black; text-align: center">
				<h1>{{total | FormatAsCurrency }}</h1>
				Total Giving
			 </div>
			 <br />
			 <small><em>No goods or services were given in exchange for the listed contributions other than intangible religious benefits.  Amounts listed are Qualified Charitable Distributions from an IRA account.  Please contact your tax advisor as to the deductibility of the contributions.</em></small>
 			  <div style="padding-top:30px;">
    			 <div style="border: 1px solid black; text-align:center;box-shadow: rgba(0, 0, 0, 0.19) 0px 10px 20px, rgba(0, 0, 0, 0.23) 0px 6px 6px; padding:15px;">
    			     <img src="data:image/png;base64," alt="MOVE Tag Line" width="200px;" />
    			     <h1>{{ MoveSummary.AmountPledged | FormatAsCurrency }} {% comment %} {{ '0' | FormatAsCurrency }} {% endcomment %}</h1>
    			     <hr style="width:75px; color:rbca(0,0,0,0.23); margin-top:0px;margin-bottom:0px;">
    			     <strong>Commitment</strong>
    			     <h1>{% if MoveSummary.PledgeDuration == 1 %}{{ MoveSummary.SecondYearAmountGiven | FormatAsCurrency }}{% else %}{{ MoveSummary.AmountGiven | FormatAsCurrency }}{% endif %}</h1>
     			     <hr style="width:75px; color:rbca(0,0,0,0.23); margin-top:0px;margin-bottom:0px;">
    			     <strong>Giving to Date</strong>
    			 </div>
     			 <br />
    			 {% if MoveSummary.PledgeDuration == 1 %}
                   <small>This section reflects giving from 4/1/2026 - 4/1/2027 towards your 1-year MOVE Commitment.</small>
                 {% else %}
                   <small>This section reflects giving from 4/1/2025 - 4/1/2027 towards your 2-year MOVE Commitment.</small>
                 {% endif %}
			 </div>
		</div>
	</div>


	<hr style="opacity: .5;" />
	<p class="text-center">
        At Southeast, we believe it is all ONE MISSION that we're on--connecting people to Jesus and one another--to unleash the full force of the church to love people one at a time. Therefore, beginning in April 2025, every gift you give to Southeast will go toward both our ongoing ministries and the vision God has placed in front of us for the future. Thank you for your generosity, and we are excited to see what God will do in us and through us as we move 
        together, forward, and closer.
	</p>
	<p class="text-center">
	    Proceeds amounts from stock donations are included in your Move Giving-to-date total but may not represent your tax-deductible amount. Please consult your tax advisor. Giving through a foundation or employee payroll deduction program will be included in your Move Giving-to-date total but not listed in the detailed transactions above since you will receive tax documentation through the foundation or program.
	</p>
	<p class="text-center">
        If you have any questions about your statement, please email giving@secc.org or call the donation hotline at 502-253-8707. Please include your name, address, telephone number and a detailed message.	    
	</p>
</div>
{%- endif -%}