<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net472</TargetFramework>
    <IsPackable>false</IsPackable>
    <LangVersion>latest</LangVersion>
  </PropertyGroup>

  <!-- Resolve RockWeb the same way LinkList.Tests does: honor an explicit
       /p:RockWebPath, then probe the rock-dev-tool layout (Rock next to the
       plugin folder) and the Rock solution layout (SolutionDir). -->
  <PropertyGroup>
    <RockWebPath Condition="'$(RockWebPath)' == '' And Exists('..\..\Rock\RockWeb\Bin')">..\..\Rock\RockWeb</RockWebPath>
    <RockWebPath Condition="'$(RockWebPath)' == '' And Exists('$(SolutionDir)RockWeb\Bin')">$(SolutionDir)RockWeb</RockWebPath>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.9.0" />
    <PackageReference Include="xunit" Version="2.7.0" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.5.7" />
  </ItemGroup>

  <ItemGroup>
    <!-- The plugin's post-build event copies its files into RockWeb. An empty PostBuildEvent
         for this reference turns that off when MSBuild builds the plugin through this reference
         from the command line. Building the plugin on its own or from Rock.sln still copies them. -->
    <ProjectReference Include="..\org.secc.Finance.csproj" AdditionalProperties="PostBuildEvent=" />
    <!-- GetStatement works with Rock's BinaryFile, Person, UserLogin and RockContext, so the
         compiler needs these Rock assemblies. The tests build those objects in memory and don't
         touch a database. -->
    <Reference Include="Rock">
      <HintPath>$(RockWebPath)\Bin\Rock.dll</HintPath>
    </Reference>
    <Reference Include="Rock.Common">
      <HintPath>$(RockWebPath)\Bin\Rock.Common.dll</HintPath>
    </Reference>
    <Reference Include="Rock.Enums">
      <HintPath>$(RockWebPath)\Bin\Rock.Enums.dll</HintPath>
    </Reference>
    <Reference Include="Rock.Lava.Shared">
      <HintPath>$(RockWebPath)\Bin\Rock.Lava.Shared.dll</HintPath>
    </Reference>
    <Reference Include="EntityFramework">
      <HintPath>$(RockWebPath)\Bin\EntityFramework.dll</HintPath>
    </Reference>
    <Reference Include="System.Web" />
  </ItemGroup>

</Project>
