<Project Sdk="Microsoft.NET.Sdk">

  <!-- SDK-style Rock plugin. Rock references, the org_secc block handling and
       the copy into RockWeb come from Directory.Build.props/.targets at the
       repo root (see Plugins/README-SdkStyle.md). -->

  <PropertyGroup>
    <TargetFramework>net472</TargetFramework>
    <IsRockPlugin>true</IsRockPlugin>
    <!-- Keep the legacy output folder (bin\Debug, bin\Release) rather than bin\Release\net472. -->
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <!-- Assembly attributes live in Properties\AssemblyInfo.cs. -->
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
  </PropertyGroup>

  <ItemGroup>
    <!-- From RockWeb\Bin, in addition to the shared default Rock references. -->
    <RockReference Include="EntityFramework.SqlServer" />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="Microsoft.CSharp" />
    <Reference Include="System.ComponentModel.Composition" />
    <Reference Include="System.ComponentModel.DataAnnotations" />
    <Reference Include="System.Data.DataSetExtensions" />
    <Reference Include="System.Net.Http" />
    <Reference Include="System.Web" />
  </ItemGroup>

</Project>
