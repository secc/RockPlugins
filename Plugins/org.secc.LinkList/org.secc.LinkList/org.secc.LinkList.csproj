<Project Sdk="Microsoft.NET.Sdk">

  <!-- SDK-style Rock plugin. Rock assemblies are referenced from RockWeb\Bin
       (the Rock we actually build and deploy) rather than the RockRMS.* NuGet
       packages, which aren't published for every Rock hotfix. RockWeb lookup,
       the shared Rock references and the copy into RockWeb\Bin come from
       Directory.Build.props/.targets at the repo root
       (see Plugins/README-SdkStyle.md). -->

  <PropertyGroup>
    <TargetFramework>net472</TargetFramework>
    <IsRockPlugin>true</IsRockPlugin>
  </PropertyGroup>

  <ItemGroup>
    <!-- Analyzers only (no build-time dependency on a Rock version). -->
    <PackageReference Include="SparkDevNetwork.Rock.Analyzers" Version="1.0.10" />
  </ItemGroup>

  <ItemGroup>
    <!-- From RockWeb\Bin, in addition to the shared default Rock references. -->
    <RockReference Include="Rock.Blocks;Rock.Rest;HtmlAgilityPack" />
    <!-- Web API comes from Rock's Bin too. (The Microsoft.AspNet.WebApi.Core
         package would drag in Newtonsoft.Json 6.0.4 and win over Rock's 13.0.) -->
    <RockReference Include="System.Web.Http;System.Net.Http.Formatting" />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="System.Net.Http" />
    <Reference Include="System.Web" />
    <Reference Include="System.Web.Extensions" />
  </ItemGroup>

</Project>
