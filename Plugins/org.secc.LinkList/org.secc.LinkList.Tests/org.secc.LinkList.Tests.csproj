<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net472</TargetFramework>
    <IsPackable>false</IsPackable>
    <LangVersion>latest</LangVersion>
    <!-- Gets the same Rock references as the plugin, but copied locally
         (Private=true) so the code under test can load them, and nothing is
         deployed to RockWeb. See Plugins/README-SdkStyle.md. -->
    <IsRockPluginTest>true</IsRockPluginTest>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.9.0" />
    <PackageReference Include="xunit" Version="2.7.0" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.5.7" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\org.secc.LinkList\org.secc.LinkList.csproj" />
    <Reference Include="System.Net.Http" />
    <!-- Everything the plugin references beyond the shared defaults, so the
         test host has the same assemblies the old NuGet packages provided. -->
    <RockReference Include="Rock.Blocks;Rock.Rest;HtmlAgilityPack;System.Web.Http;System.Net.Http.Formatting" />
  </ItemGroup>

</Project>
