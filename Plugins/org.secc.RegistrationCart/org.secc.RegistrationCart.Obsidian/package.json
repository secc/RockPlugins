{
    "name": "org.secc.registrationcart.obsidian",
    "private": true,
    "scripts": {
        "build": "npm run typecheck && rimraf dist && obsidian-build",
        "deploy": "npm run build && xcopy /Y /R /E /I dist ..\\..\\..\\..\\Rock\\RockWeb\\Plugins\\org_secc\\RegistrationCart",
        "typecheck": "vue-tsc --noEmit -p src",
        "watch": "obsidian-build --watch",
        "clean": "rimraf dist",
        "viewmodels": "rock-dev-tool generate viewmodels ../org.secc.RegistrationCart/bin/Debug/net472/org.secc.RegistrationCart.dll -o src"
    },
    "dependencies": {
        "@rockrms/obsidian-framework": "1.16.9-rc.1"
    },
    "devDependencies": {
        "@sparkdevnetwork/obsidian-build-tools": "^1.0.13",
        "@types/node": "^20.5.7",
        "rimraf": "^5.0.1",
        "tslib": "^2.6.2",
        "typescript": "^5.5.4",
        "vue": "^3.2.0",
        "vue-tsc": "^2.1.6"
    }
}
