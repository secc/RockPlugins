<template>
    <span class="regcart-theme" aria-hidden="true"></span>
</template>

<style>
/* ============================================================
   Registration Cart — Southeast Christian Church Design System v4
   (ROCK-9395). Eight neutrals with no accent colour, Ivy Journal
   for headings, Inter for everything else, pill buttons, white
   10px hairline cards with no shadow.

   Colours, spacing, radii and shadows are the guide's tokens, the
   same values as Themes/SECC2024/Styles/rock/_camp-registration.scss;
   keep the two in sync. Type sizes keep the guide's proportions
   with body copy at 16px, as that partial does.

   The fonts come from the site theme (SECC2024 loads Inter and
   Ivy Journal 600); on any other theme the fallbacks apply.
   ============================================================ */
.regcart {
    /* tokens/colors.css */
    --white: #FFFFFF;
    --page-bg: #F5F4F2;
    --black: #0F0F0F;
    --charcoal: #1C1C1C;
    --dark-gray: #3A3A3A;
    --mid-gray: #888888;
    --light-gray: #D4D2CE;
    --hairline: #E4E2DE;
    --surface-hover: #FBFAF8;
    /* tokens/spacing.css */
    --s1: 4px; --s2: 8px; --s3: 12px; --s4: 18px; --s5: 22px; --s6: 28px; --s7: 32px; --s8: 52px;
    /* tokens/radius.css */
    --radius-btn: 100px;
    --radius-card: 10px;
    --radius-input: 8px;
    /* tokens/elevation.css: only for things that lift */
    --shadow-card: 0 1px 3px rgba(0, 0, 0, 0.07), 0 1px 2px rgba(0, 0, 0, 0.04);
    --shadow-hover: 0 6px 20px rgba(0, 0, 0, 0.11), 0 2px 6px rgba(0, 0, 0, 0.05);
    --shadow-dark: 0 8px 28px rgba(0, 0, 0, 0.22);

    /* The cart's own names, mapped onto the guide's tokens. */
    --rc-paper: var(--page-bg);
    --rc-card: var(--white);
    --rc-ink: var(--charcoal);
    --rc-ink-soft: var(--dark-gray);
    --rc-muted: var(--mid-gray);
    --rc-line: var(--hairline);
    --rc-line-soft: var(--hairline);
    --rc-accent: var(--charcoal);
    --rc-accent-dark: var(--dark-gray);
    --rc-forest: var(--charcoal);
    /* Not in the guide, which has no error colour. */
    --rc-danger: #B3261E;
    --rc-serif: "Ivy Journal", "IvyJournal", Georgia, "Times New Roman", serif;
    --rc-sans: "Inter", "Helvetica Neue", Arial, sans-serif;

    background: var(--rc-paper);
    color: var(--dark-gray);
    font-family: var(--rc-sans);
    font-size: 16px;
    line-height: 1.6;
    padding: var(--s7) var(--s7) var(--s8);
    border-radius: var(--radius-card);
    margin: 0 0 24px;
    -webkit-font-smoothing: antialiased;
    -moz-osx-font-smoothing: grayscale;
}
.regcart *, .regcart *::before, .regcart *::after { box-sizing: border-box; }
.regcart a { color: var(--charcoal); text-decoration: underline; text-underline-offset: 2px; }
.regcart a:hover { color: var(--dark-gray); }
.regcart h1, .regcart h2, .regcart h3, .regcart .rc-serif { font-family: var(--rc-serif); font-weight: 600; font-synthesis: none; color: var(--charcoal); margin: 0; letter-spacing: -.012em; text-transform: none; }
.regcart h1 { font-size: 2.3rem; line-height: 1.1; letter-spacing: -.022em; }
.regcart h2 { font-size: 1.5rem; line-height: 1.15; }
.regcart h3 { font-size: 1.35rem; line-height: 1.15; }
.regcart p { margin: 0; }
.regcart b, .regcart strong { font-weight: 600; color: var(--black); }
.regcart .rc-lead { font-size: 1.05rem; color: var(--dark-gray); max-width: 640px; }
.regcart .rc-muted { color: var(--mid-gray); }
.regcart .rc-small { font-size: .875rem; }
.regcart .rc-eyebrow { font-family: var(--rc-sans); font-size: .75rem; letter-spacing: .24em; text-transform: uppercase; font-weight: 500; color: var(--mid-gray); }
.regcart .rc-accent { color: var(--charcoal); }
.regcart .rc-italic { font-style: italic; }

/* Header band */
.regcart .rc-header { display: flex; align-items: flex-end; justify-content: space-between; gap: 24px; border-bottom: 1px solid var(--hairline); padding-bottom: var(--s4); margin-bottom: var(--s6); flex-wrap: wrap; }
.regcart .rc-header-text { display: flex; flex-direction: column; gap: 6px; }
.regcart .rc-back { display: inline-flex; align-items: center; gap: 6px; font-size: .8rem; font-weight: 600; letter-spacing: .14em; text-transform: uppercase; text-decoration: none; margin-bottom: 4px; }

/* Buttons: .link-btn (white pill) and .featured (charcoal pill) */
.regcart .rc-btn, .regcart .rc-nav a { display: inline-flex; align-items: center; justify-content: center; gap: 8px; border: 1px solid var(--hairline); border-radius: var(--radius-btn); padding: 17px 28px; font-family: var(--rc-sans); font-weight: 600; font-size: .85rem; letter-spacing: .15em; text-transform: uppercase; white-space: nowrap; color: var(--charcoal); background: var(--white); box-shadow: var(--shadow-card); cursor: pointer; line-height: 1; text-decoration: none; transition: box-shadow .18s, background .18s, border-color .18s, transform .14s; }
.regcart .rc-btn:hover, .regcart .rc-nav a:hover { color: var(--charcoal); background: var(--white); border-color: var(--light-gray); box-shadow: var(--shadow-hover); transform: translateY(-2px); }
.regcart .rc-btn-primary, .regcart .rc-btn-primary:focus { background: var(--charcoal); border-color: var(--charcoal); color: var(--white); }
.regcart .rc-btn-primary:hover { background: var(--dark-gray); border-color: var(--dark-gray); color: var(--white); box-shadow: var(--shadow-dark); }
.regcart .rc-btn-block { width: 100%; white-space: normal; }
.regcart .rc-btn[disabled], .regcart .rc-btn.disabled, .regcart .rc-btn[disabled]:hover, .regcart .rc-btn.disabled:hover { color: var(--light-gray); background: var(--white); border-color: var(--hairline); box-shadow: none; transform: none; cursor: not-allowed; }
.regcart .rc-link-btn { background: none; border: 0; padding: 0; font: inherit; font-weight: 600; color: var(--charcoal); text-decoration: underline; text-underline-offset: 2px; cursor: pointer; }
.regcart .rc-link-btn:hover { color: var(--dark-gray); }
.regcart .rc-link-btn[disabled] { color: var(--light-gray); cursor: not-allowed; }
.regcart .rc-link-danger, .regcart .rc-link-danger:hover { color: var(--rc-danger); }
.regcart .rc-dashed { border-style: dashed; border-color: var(--light-gray); box-shadow: none; padding: 12px 18px; font-size: .8rem; letter-spacing: .14em; }

/* Nav pill (cart badge) */
.regcart .rc-nav { display: flex; gap: 10px; align-items: center; }
.regcart .rc-nav a { padding: 12px 18px; font-size: .8rem; letter-spacing: .14em; }
.regcart .rc-badge { background: var(--charcoal); color: var(--white); border-radius: var(--radius-btn); font-size: .75rem; letter-spacing: 0; padding: 2px 8px; line-height: 1.4; font-variant-numeric: tabular-nums; }

/* Cards & panels: white, 1px hairline, 10px radius, no shadow */
.regcart .rc-card { background: var(--white); border: 1px solid var(--hairline); border-radius: var(--radius-card); }
/* The SECC2024 theme zeroes the padding of every section element, so the panel states its own. */
.regcart .rc-panel { background: var(--white); border: 1px solid var(--hairline); border-radius: var(--radius-card); padding: var(--s5) !important; }

/* Leaves room for the site's fixed header when the page scrolls up to what's missing. */
.regcart .rc-step, .regcart .alert-validation { scroll-margin-top: 110px; }

/* A template's Pre/Post HTML often opens a Bootstrap row on one field and closes it on a later
   one. Each piece is rendered on its own here, which leaves empty floated columns that push the
   next label sideways, so empty layout pieces are dropped and every field starts on its own line. */
.regcart .rc-form-html .row:not(:has(*:not(.row):not([class*="col-"]))) { display: none; }
.regcart .rc-form-html [class*="col-"]:empty { display: none; }
.regcart .rc-form-field { clear: both; }

/* Rock's own theme.css, which places an Obsidian modal over the page, is not loaded on the
   public site, so without these the modal renders below the footer behind its backdrop.
   The modal is mounted on the body, outside .regcart. Rock's block-settings dialog
   (#modal-popup) shares the classes and is left to Rock's admin styles. */
.modal-scrollable { position: fixed; top: 0; right: 0; bottom: 0; left: 0; overflow: auto; z-index: 1050; }
.modal-scrollable > .rock-modal:not(#modal-popup) { margin: 10vh auto 40px !important; top: auto !important; left: auto !important; position: relative !important; width: 100%; max-width: min(640px, calc(100vw - 32px)); }
.regcart .rc-rail { background: var(--white); color: var(--dark-gray); border: 1px solid var(--hairline); border-radius: var(--radius-card); padding: var(--s5); display: flex; flex-direction: column; gap: 14px; position: sticky; top: 24px; }

/* Steps */
.regcart .rc-step { display: flex; flex-direction: column; gap: 14px; margin-bottom: var(--s6); }
.regcart .rc-step-title { display: flex; align-items: baseline; gap: 14px; }
.regcart .rc-step-num { font-family: var(--rc-sans); font-size: .75rem; font-weight: 500; letter-spacing: .24em; line-height: 1; color: var(--mid-gray); font-variant-numeric: tabular-nums; }

/* People chips */
.regcart .rc-chips { display: flex; gap: 10px; flex-wrap: wrap; }
.regcart .rc-chip { display: inline-flex; align-items: center; gap: 10px; border: 1px solid var(--hairline); border-radius: var(--radius-btn); padding: 8px 18px 8px 8px; background: var(--white); color: var(--charcoal); box-shadow: var(--shadow-card); cursor: pointer; font: inherit; text-align: left; transition: box-shadow .18s, border-color .18s, transform .14s; }
.regcart .rc-chip:hover { border-color: var(--light-gray); box-shadow: var(--shadow-hover); transform: translateY(-2px); }
.regcart .rc-chip-selected, .regcart .rc-chip-selected:hover { background: var(--charcoal); border-color: var(--charcoal); color: var(--white); }
.regcart .rc-avatar { width: 32px; height: 32px; border-radius: 50%; background: var(--page-bg); color: var(--charcoal); display: inline-flex; align-items: center; justify-content: center; font-weight: 600; font-size: 13px; flex-shrink: 0; }
.regcart .rc-chip-selected .rc-avatar { background: var(--white); color: var(--charcoal); }
.regcart .rc-chip-text { display: flex; flex-direction: column; line-height: 1.15; }
.regcart .rc-chip-text b { font-size: 15px; color: inherit; }
.regcart .rc-chip-text span { font-size: 12px; color: var(--mid-gray); }
.regcart .rc-chip-selected .rc-chip-text span { color: var(--light-gray); }

.regcart .rc-chip-dim:not(.rc-chip-selected) { background: transparent; box-shadow: none; }
.regcart .rc-chip-dim:not(.rc-chip-selected) b { color: var(--mid-gray); font-weight: 500; }
.regcart .rc-avatar .rc-ico { width: 14px; height: 14px; }
.regcart .rc-chip-plain { padding: 12px 20px; font-weight: 600; font-size: 15px; }

/* Option rows (radio) */
.regcart .rc-options { display: flex; flex-direction: column; gap: 10px; }
.regcart .rc-option { display: grid; grid-template-columns: 24px 1fr auto; align-items: center; gap: 16px; background: var(--white); border: 1px solid var(--hairline); border-radius: var(--radius-card); padding: 14px 18px; cursor: pointer; margin: 0; font-weight: normal; transition: border-color .15s; }
.regcart .rc-option:hover { border-color: var(--light-gray); }
.regcart .rc-option input { margin: 0; accent-color: var(--charcoal); width: 18px; height: 18px; }
.regcart .rc-option-main { display: flex; flex-direction: column; gap: 2px; }
.regcart .rc-option-main b { font-size: 1rem; }
.regcart .rc-option-main span { font-size: .875rem; color: var(--mid-gray); }
.regcart .rc-option-price { font-family: var(--rc-sans); font-size: 1.1rem; font-weight: 600; color: var(--black); font-variant-numeric: tabular-nums; }
.regcart .rc-option-selected, .regcart .rc-option-selected:hover { border-color: var(--charcoal); }
.regcart .rc-option-disabled, .regcart .rc-option-disabled:hover { border-color: var(--hairline); color: var(--light-gray); cursor: not-allowed; background: var(--page-bg); }
.regcart .rc-option-disabled b, .regcart .rc-option-disabled .rc-option-main span, .regcart .rc-option-disabled .rc-option-price { color: var(--light-gray); }

/* An option that links to its registration (catalog camp page) */
.regcart .rc-option-link { grid-template-columns: 1fr auto auto; cursor: default; }
.regcart .rc-option-link .rc-btn { padding: 12px 18px; font-size: .8rem; letter-spacing: .14em; }

/* Add-on list */
.regcart .rc-addons { background: var(--white); border: 1px solid var(--hairline); border-radius: var(--radius-card); padding: 4px 20px; }
.regcart .rc-addon-group { padding: 12px 0 4px; border-bottom: 1px solid var(--hairline); }
.regcart .rc-addon-group:last-child { border-bottom: 0; }
.regcart .rc-addon-row { display: grid; grid-template-columns: 20px 1fr auto; gap: 14px; align-items: center; padding: 10px 0; margin: 0; font-weight: normal; cursor: pointer; }
.regcart .rc-addon-row input { margin: 0; accent-color: var(--charcoal); width: 17px; height: 17px; }
.regcart .rc-addon-row input[disabled] { opacity: .6; }
.regcart .rc-addon-price { color: var(--black); font-weight: 600; font-variant-numeric: tabular-nums; }
.regcart .rc-addon-included { color: var(--mid-gray); font-size: .875rem; }

/* Catalog */
.regcart .rc-feature { display: grid; grid-template-columns: 280px 1fr; background: var(--white); border: 1px solid var(--hairline); border-radius: var(--radius-card); overflow: hidden; margin-bottom: 20px; }
.regcart .rc-feature-side { background: var(--charcoal); color: var(--white); padding: 24px; display: flex; flex-direction: column; justify-content: space-between; gap: 24px; min-height: 220px; background-size: cover; background-position: center; }
.regcart .rc-feature-side .rc-eyebrow { color: var(--light-gray); }
.regcart .rc-feature-date { font-family: var(--rc-serif); font-weight: 600; font-size: 2.3rem; line-height: 1; letter-spacing: -.022em; }
.regcart .rc-feature-body { padding: var(--s6); display: flex; flex-direction: column; gap: 12px; }
.regcart .rc-grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 20px; }
.regcart .rc-tile { display: flex; flex-direction: column; gap: 10px; padding: var(--s5); }
.regcart .rc-tile-foot { display: flex; justify-content: space-between; align-items: center; margin-top: auto; padding-top: 8px; }
.regcart .rc-price { font-family: var(--rc-sans); font-size: 1.1rem; font-weight: 600; color: var(--black); font-variant-numeric: tabular-nums; }
.regcart .rc-from { font-size: .875rem; color: var(--mid-gray); }
.regcart .rc-pills { display: flex; gap: 8px; flex-wrap: wrap; }
.regcart .rc-pill { border: 1px solid var(--hairline); border-radius: var(--radius-btn); padding: 4px 12px; font-size: .8125rem; color: var(--dark-gray); background: var(--white); }

.regcart .rc-section-title { margin: var(--s8) 0 var(--s2); }
.regcart .rc-grid + .rc-section-title { margin-top: var(--s8); }

/* Two-column layout with rail */
.regcart .rc-layout { display: grid; grid-template-columns: 1fr 320px; gap: var(--s6); align-items: start; }

/* Cart lines */
.regcart .rc-registrant { margin-bottom: var(--s4); }
.regcart .rc-registrant h2 { padding: 0 0 8px; }
.regcart .rc-line { display: flex; justify-content: space-between; gap: 16px; padding: 14px 0; border-top: 1px solid var(--hairline); }
.regcart .rc-line:first-of-type { border-top: 0; }
.regcart .rc-line-items { list-style: none; padding: 0; margin: 6px 0 0; }
.regcart .rc-line-items li { display: flex; justify-content: space-between; gap: 16px; font-size: .875rem; color: var(--mid-gray); font-variant-numeric: tabular-nums; }
.regcart .rc-line-side { text-align: right; min-width: 6rem; display: flex; flex-direction: column; gap: 4px; align-items: flex-end; }
.regcart .rc-line-total { font-family: var(--rc-sans); font-size: 1.1rem; font-weight: 600; color: var(--black); font-variant-numeric: tabular-nums; }

/* Totals */
.regcart .rc-totals { margin: 0; display: flex; flex-direction: column; gap: 8px; font-size: .9375rem; font-variant-numeric: tabular-nums; }
.regcart .rc-totals > div { display: flex; justify-content: space-between; align-items: baseline; }
.regcart .rc-totals dt, .regcart .rc-totals dd { margin: 0; font-weight: normal; }
.regcart .rc-totals .rc-grand { border-top: 1px solid var(--hairline); padding-top: 12px; margin-top: 4px; }
.regcart .rc-totals .rc-grand dt { font-weight: 600; color: var(--black); }
.regcart .rc-totals .rc-grand dd { font-family: var(--rc-sans); font-size: 1.5rem; font-weight: 600; color: var(--black); line-height: 1; }
.regcart .rc-discount-row dt { display: flex; align-items: center; gap: 6px; }

/* Inputs: components.css .field */
.regcart .rc-input, .regcart .form-control { width: 100%; height: auto; min-height: 44px; padding: 10px 12px; border: 1px solid var(--hairline); border-radius: var(--radius-input); font-family: var(--rc-sans); font-size: 1rem; font-weight: 400; line-height: 1.4; color: var(--black); background-color: var(--white); background-image: none; box-shadow: none; transition: border-color .15s; }
.regcart .rc-input::placeholder, .regcart .form-control::placeholder { color: var(--mid-gray); opacity: 1; }
.regcart .rc-input:focus, .regcart .form-control:focus { border-color: var(--charcoal); outline: none; box-shadow: none; }
.regcart .rc-input[disabled], .regcart .form-control[disabled] { color: var(--light-gray); background-color: var(--page-bg); }
.regcart textarea.form-control { min-height: 96px; }
.regcart .rc-input-row { display: flex; gap: 8px; align-items: center; }
.regcart .form-group { margin-bottom: var(--s5); }
/* The SECC2024 theme sets label weight with !important. */
.regcart .control-label, .regcart .rc-field-label { display: block; text-align: left; margin-bottom: 5px; font-family: var(--rc-sans); font-size: .75rem; font-weight: 600 !important; line-height: 1.4; color: var(--mid-gray); text-transform: uppercase; letter-spacing: .09em; }
.regcart .form-group.required .control-label:after { color: var(--dark-gray); }
.regcart .help-block { margin-top: 5px; font-size: .875rem; color: var(--mid-gray); }
.regcart .has-error .form-control { border-color: var(--rc-danger); }
.regcart .has-error .control-label { color: var(--rc-danger); }
.regcart .checkbox label, .regcart .radio label, .regcart .radio-inline, .regcart .checkbox-inline { font-weight: 400; color: var(--dark-gray); }
.regcart input[type="checkbox"], .regcart input[type="radio"] { accent-color: var(--charcoal); }
/* Obsidian drop-downs are ant-design selects that carry .form-control. */
.regcart .ant-select.form-control { padding: 0; cursor: pointer; }
.regcart .ant-select.form-control .ant-select-selector { align-items: center; height: auto !important; min-height: 42px; padding: 0 36px 0 12px !important; background: transparent !important; border: 0 !important; border-radius: var(--radius-input) !important; box-shadow: none !important; }
.regcart .ant-select.form-control.ant-select-single .ant-select-selection-item, .regcart .ant-select.form-control.ant-select-single .ant-select-selection-placeholder { padding-right: 0; line-height: 42px; }
.regcart .ant-select.form-control .ant-select-selection-placeholder { color: var(--mid-gray); }
.regcart .ant-select.form-control .ant-select-arrow { right: 14px; color: var(--mid-gray); }
.regcart .ant-select.form-control.ant-select-focused:not(.ant-select-disabled) { border-color: var(--charcoal); box-shadow: none; }
.regcart .ant-select.form-control.ant-select-disabled { color: var(--light-gray); background-color: var(--page-bg); }
.regcart .input-group-addon { color: var(--mid-gray); background: var(--page-bg); border-color: var(--hairline); }
/* Signing: the document on its own, in a reading-width column. */
.regcart .rc-sign { max-width: 820px; margin: 0 auto; display: flex; flex-direction: column; gap: var(--s3); scroll-margin-top: 110px; }
.regcart .rc-sign h2 { margin: 0; }
.regcart .rc-sign p { margin: 0; }
.regcart .rc-sign button.rc-back { background: none; border: 0; padding: 0; cursor: pointer; align-self: flex-start; }
.regcart .rc-signature-doc { width: 100%; height: min(60vh, 640px); min-height: 320px; border: 1px solid var(--hairline); border-radius: var(--radius-input); background: var(--white); }
/* Birthday month / day / year stay on one line. */
.regcart .birthday-picker .form-control-group, .rock-modal .birthday-picker .form-control-group { display: flex; align-items: center; gap: var(--s2); }
.regcart .birthday-picker .form-control-group .form-control, .rock-modal .birthday-picker .form-control-group .form-control { flex: 0 1 auto; width: auto; min-width: 0; margin: 0; }

/* Notices: 8px radius, hairline, neutral surface, 3px left rule. Red only on danger. */
.regcart .rc-notice { display: flex; gap: 12px; align-items: flex-start; border: 1px solid var(--hairline); border-left: 3px solid var(--charcoal); border-radius: var(--radius-input); padding: var(--s4) var(--s5); background: var(--white); color: var(--dark-gray); }
.regcart .rc-notice-danger { border-left-color: var(--rc-danger); }
.regcart .rc-notice ul { margin: 6px 0 0; padding-left: 18px; }
.regcart .rc-error { color: var(--rc-danger); font-weight: 600; font-size: .875rem; }
.regcart .rc-empty { text-align: center; padding: 48px 16px; display: flex; flex-direction: column; gap: 16px; align-items: center; }

/* Confirmation */
.regcart .rc-confirm { max-width: 560px; margin: 0 auto; text-align: center; display: flex; flex-direction: column; gap: 14px; align-items: center; padding: 24px 0; }
.regcart .rc-confirm-mark { width: 72px; height: 72px; border-radius: 50%; border: 1px solid var(--hairline); background: var(--white); display: inline-flex; align-items: center; justify-content: center; color: var(--charcoal); }
.regcart .rc-confirm ul { list-style: none; padding: 0; margin: 0; display: flex; flex-direction: column; gap: 6px; }

/* Icons */
.regcart .rc-ico { width: 16px; height: 16px; flex-shrink: 0; }

/* Focus is explicit and never removed. */
.regcart a:focus-visible, .regcart button:focus-visible, .regcart .rc-btn:focus-visible, .regcart input[type="checkbox"]:focus-visible, .regcart input[type="radio"]:focus-visible { outline: 2px solid var(--charcoal); outline-offset: 2px; }

@media (prefers-reduced-motion: reduce) {
    .regcart *, .regcart *::before, .regcart *::after { transition-duration: .01ms !important; animation-duration: .01ms !important; }
    .regcart .rc-btn:hover, .regcart .rc-nav a:hover, .regcart .rc-chip:hover { transform: none !important; }
}

@media (max-width: 860px) {
    .regcart { padding: var(--s5) var(--s4) var(--s7); }
    .regcart h1 { font-size: 1.75rem; letter-spacing: -.012em; }
    .regcart .rc-layout { grid-template-columns: 1fr; }
    .regcart .rc-rail { position: static; }
    .regcart .rc-feature { grid-template-columns: 1fr; }
    .regcart .rc-grid { grid-template-columns: 1fr; }
