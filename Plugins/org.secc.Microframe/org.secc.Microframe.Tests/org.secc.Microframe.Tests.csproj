<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net472</TargetFramework>
    <IsPackable>false</IsPackable>
    <LangVersion>latest</LangVersion>
    <!-- Build org.secc.DevLib, which org.secc.Microframe references, only through
         org.secc.Microframe, so the properties below apply to it too. -->
    <DisableTransitiveProjectReferences>true</DisableTransitiveProjectReferences>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.9.0" />
    <PackageReference Include="xunit" Version="2.7.0" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.5.7" />
  </ItemGroup>

  <ItemGroup>
    <!-- org.secc.Microframe skips its copy into RockWeb when CopyToRockWeb is false, and an empty
         PostBuildEvent turns off any project's post-build event. Both apply when MSBuild builds the
         plugin through this reference from the command line, including org.secc.DevLib. Visual
         Studio builds each plugin as its own project, so building the plugin on its own or from
         Rock.sln still copies it. org.secc.Microframe resolves Rock from $(SolutionDir)RockWeb\Bin,
         so a command-line build passes /p:SolutionDir. The tests use only MicroframeConnection,
         whose public members use .NET types, against a stand-in sign on the loopback address. -->
    <ProjectReference Include="..\org.secc.Microframe.csproj" AdditionalProperties="CopyToRockWeb=false;PostBuildEvent=" />
  </ItemGroup>

</Project>
