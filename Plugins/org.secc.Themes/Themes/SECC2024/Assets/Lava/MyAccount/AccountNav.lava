{% assign currentPage = 'Global' | Page:'Path' %}



<!-- Sidebar -->
<ul class="sidebar-nav">
    <!-- <li>
        <a href="/MyDashboard"><i class="fal fa-th-large g-font-size-26--xs"></i> Dashboard</a>
    </li> -->
    <li {% if currentPage == '/MyAccount' %} class="active" {% endif %}>
        <a class="g-font-weight--400 g-font-size-18--xs" href="/MyAccount"><i class="fal fa-user-circle g-font-size-26--xs"></i> Account</a>
    </li>
    <li {% if currentPage == '/my-classes' %} class="active" {% endif %}>
        <a class="g-font-weight--400 g-font-size-18--xs" href="/my-classes"><i class="fal fa-users-class g-font-size-26--xs"></i> Classes</a>
    </li>
    <li {% if currentPage == '/MyGiving' %} class="active" {% endif %}>
        <a class="g-font-weight--400 g-font-size-18--xs" href="/MyGiving"><i class="fal fa-heart g-font-size-26--xs"></i> Giving</a>
    </li>
    {%-comment-%}Financial Coaching{%-endcomment-%}
    {%- assign groupMembers = CurrentPerson | Group: "968132" -%}
    {%- for groupMember in groupMembers -%}
        {%- if groupMember.GroupRoleId == 826 or groupMember.GroupRoleId == 1343 -%}
        <li {% if currentPage == '/MyAccount/MyFinancialCoachingCases' %} class="active" {% endif %}>
            <a class="g-font-weight--400 g-font-size-18--xs" href="/MyAccount/MyFinancialCoachingCases"><i class="fal fa-comment-alt-dollar g-font-size-26--xs"></i></i> Coaching</a>
        </li>
        {%- endif -%}
    {%- endfor -%}
    {%-comment-%}MOVE Leader Coaching{%-endcomment-%}
    {%- assign groupMembers = CurrentPerson | Group: "1400552" -%}
    {%- for groupMember in groupMembers -%}
        {%- if groupMember.GroupRoleId == 1373 or groupMember.GroupRoleId == 1374 -%}
        <li {% if currentPage == '/MyAccount/MyStakeholderCases' %} class="active" {% endif %}>
            <a class="g-font-weight--400 g-font-size-18--xs" href="/MyAccount/MyStakeholders"><i class="fal fa-light fa-handshake g-font-size-26--xs"></i></i> MOVE</a>
        </li>
        {%- endif -%}
    {%- endfor -%}
    {%-comment-%}Volunteer Status{%-endcomment-%}
    {%- assign groupMembers = CurrentPerson | Group: "2" -%}
    {%- for groupMember in groupMembers -%}
        <li {% if currentPage == '/MyVolunteerStatus' %} class="active" {% endif %}>
            <a class="g-font-weight--400 g-font-size-18--xs" href="/MyVolunteerStatus"><i class="fal fa-solid fa-user-check g-font-size-26--xs"></i></i> Volunteer</a>
        </li>
    {%- endfor -%}
    <li {% if currentPage == '/MyEvents' %} class="active" {% endif %}>
        <a class="g-font-weight--400 g-font-size-18--xs" href="/MyEvents"><i class="fal fa-users g-font-size-26--xs"></i> Events</a>
    </li>
    <li {% if currentPage == '/MySchedule' %} class="active" {% endif %}>
        <a class="g-font-weight--400 g-font-size-18--xs" href="/MySchedule"><i class="fal fa-calendar-day g-font-size-26--xs"></i> Schedule</a>
    </li>
    <li>
        <a class="g-font-weight--400 g-font-size-18--xs" href="/logout"><i class="fal fa-sign-out-alt g-font-size-26--xs fa-flip-horizontal"></i> Logout</a>
    </li>
</ul>
<!-- /#sidebar-wrapper -->
