<style>
    .se-carat {
        left: -2.5rem;
    }
</style>

<script>
	function removeGuestKR(el) {
		const webhookUrl = "https://my.southeastchristian.org/Webhooks/LaunchWorkflow.ashx?WorkflowTypeId=835";

		const krId = el.dataset.krid;
		const guestGuid = el.dataset.guestguid;

		const payload = {
			KnownRelationshipOwnerId: krId,
			GuestGuid: guestGuid
		};

		fetch(webhookUrl, {
			method: "POST",
			headers: {
				"Content-Type": "application/json",
			},
			body: JSON.stringify(payload)
		})
		.then(response => {
			if (response.ok) {
				window.location.reload();
			} else {
				alert("Failed to remove guest.");
			}
		})
		.catch(error => {
			console.error("Error:", error);
			alert("An error occurred while triggering the workflow.");
		});
	}

	let removeGuestButtonKR = null;

	function confirmRemoveKR(el) {
		removeGuestButtonKR = el;
		removeGuestButtonKR.style.display = "none";

		var confirmRemoveClass = "confirmRemoveKR-" + el.dataset.krid;

		var confirmRemoveElements = document.querySelectorAll(`.${confirmRemoveClass}`);

		confirmRemoveElements.forEach(element => {
			element.style.display = "block";
		});
	}

	function cancelRemoveKR(el){
		removeGuestButtonKR.style.display = "block";

		var confirmRemoveClass = "confirmRemoveKR-" + el.dataset.krid;

		var confirmRemoveElements = document.querySelectorAll(`.${confirmRemoveClass}`);

		confirmRemoveElements.forEach(element => {
			element.style.display = "none";
		});
	}
</script>

{% if CurrentPerson.AgeClassification == 'Child' %}
	{% assign isAdult = false  %}
{% else %}
	{% assign isAdult = true  %}
{% endif %}

{% assign familyName = '' %}

{% assign zIndexC = rows | Size | Plus: 10 %}

<div id="family" class="fluid-container g-padding-x-0--xs g-padding-y-60--xs">
    {% for row in rows %}
		{% if familyName != row.FamilyName %}
			{% assign familyName = row.FamilyName %}
			{% assign index =  forloop.index0 %}
			{% if index > 0 %}
				</div> {% comment %} Close out the last family {% endcomment %}
			{% endif %}
			<div class="row">
				<div class="col-md-12 text-center g-padding-b-20--xs g-padding-x-40--xs">
					<h2 class="g-font-family--secondary">{{ row.FamilyName}}</h2>
				</div>
			</div>
			<div class="isotope_wrap clearfix">
			{% endif %}
				{% assign person = row.PersonId | PersonById %}
				<div class="isotope_item col-xs-12 col-sm-12 col-md-6 col-lg-4 g-padding-x-40--xs g-padding-x-20--md">
					<div class="se-panel" style="z-index: {{ zIndexC }}">
						{% if isAdult -%}
							<span class="g-position--absolute g-padding-y-20--xs g-padding-x-15--xs" style="right: 0px;top: 6px;z-index:100;">
								<a href="/MyAccount/Edit/{{ person.Guid }}" title="Change Account Info" class="se-action-btn g-padding-y-15--xs g-padding-x-15--xs g-color--dark g-radius--circle g-bg-color-hover--black-opacity-lightest">
									<i class="fas fa-user-edit"></i>
								</a>
								<a href="/MyAccount/Remove/{{ person.Guid }}" title="Remove From Family" class="se-action-btn g-padding-y-15--xs g-padding-x-15--xs g-color--dark g-radius--circle g-bg-color-hover--black-opacity-lightest">
									<i class="fas fa-user-times"></i>
								</a>
							</span>
						{% endif -%}
						<span class="g-padding-y-40--xs g-padding-x-60--xs g-padding-y-60--sm g-padding-x-80--sm g-padding-y-80--lg g-padding-x-120--lg">
							{% assign avatar = "" %}
							<a href="/MyAccount/Edit/{{ person.Guid }}">
								{% if Person.PhotoUrl != " "%}
									{% assign avatar = person.PhotoUrl %}
								{% elseif familyMember.GroupRoleId == 3 %}
									{% if person.Gender == "Male" %}
										{% assign avatar = "/Themes/SECC2024/Assets/img/SE/Users/Man_Avatar.svg" %}
									{% elseif person.Gender == "Female" %}
										{% assign avatar = "/Themes/SECC2024/Assets/img/SE/Users/Woman_Avatar.svg" %}
									{% else %}
										<!-- Bi-gender? -->
									{% endif %}
								{% elseif familyMember.GroupRoleId == 4 %}
									{% if person.Gender == "Male" %}
										{% assign avatar = "/Themes/SECC2024/Assets/img/SE/Users/Boy_Avatar.svg" %}
									{% elseif person.Gender == "Female" %}
										{% assign avatar = "/Themes/SECC2024/Assets/img/SE/Users/Girl_Avatar.svg" %}
									{% else %}
										<!-- Bi-gender? -->
									{% endif %}
								{% else %}
								<!-- Not a kid or an adult? -->
								{% endif %}
								<img src="{{ avatar }}&Size=180" title="Change Image" class="img-responsive img-circle" style="margin: 0 auto; max-width: 180px;">
							</a>
						</span>
						<div class="caption g-padding-b-40--xs">
							<div class="g-position--relative clearfix">
								{[ faq columns:'1' autoheight:'true' accordionclass:'accordions-nostyle']}
									[[ item title:'{{ person.FullName }}' ]]
										<div class="g-padding-x-20--xs g-padding-y-20--xs">
											<p>
												<span class="g-font-weight--600">Age</span><br />
												{% if person.NickName %}
													{{ person.Age }} Years ({{ person.BirthDate | Date:'M/d/yyyy'}})
												{% endif %}
											</p>
												<br />
											<p>
											<span class="g-font-weight--600">Gender</span><br />
												{% if person.Gender %}
													{{ person.Gender }}
												{% endif %}
											</p>
											<br />
											{% if familyMember.GroupRoleId != 4 %}
												<p>
													<span class="g-font-weight--600">Martial Status</span><br />
														{% definedvalue where:'DefinedTypeId == 7' sort:'Value' %}
															{% for definedValueItem in definedvalueItems %}
																{% if person.MaritalStatusValueId == definedValueItem.Id %}
																	{{ definedValueItem.Value }} ({{ person.AnniversaryDate | Date:'M/d' }})
																{% endif %}
															{% endfor %}
														{% enddefinedvalue %}
												</p>
												<br />
											{% endif %}
											<p>
												<span class="g-font-weight--600">Email</span><br />
													{% if person.Email != "" %}
														{{ person.Email }}
													{% else %}
														Email address is not set.
													{% endif %}
											</p>
											<br />
											<p>
												<span class="g-font-weight--600">Address</span><br />
													{% assign personalHome =  person | Address:'Home' %}
													{% if personalHome != '' %}
														{{ personalHome }}
												{% endif %}
											</p>
												<br />
											<p>
												<span class="g-font-weight--600">Phone</span><br />
													{% for phone in person.PhoneNumbers %}
														{{ phone.NumberFormatted }} <small>({{ phone.NumberTypeValue.Value }})</small><br />
													{% endfor %}
											</p>
												<br />
											{% if person.AgeClassification == 'Child' %}
												{% assign allergy = person | Attribute:'Allergy' %}
												{% assign allergySize = allergy | Size %}
												{% if allergySize > 0 %}
													<p>
														<span class="g-font-weight--600">Allergy:</span><br />
														{{ allergy }}
													</p>
													<br />
												{% endif %}
												{% assign medicalNotes = person | Attribute:'MedicalNotes' %}
												{% assign medicalNotesSize = medicalNotes | Size %}
												{% if medicalNotesSize > 0 %}
													<p>
														<span class="g-font-weight--600">Medical Notes:</span><br />
														{{ medicalNotes }}
													</p>
													<br />
												{% endif %}
												<p>
												<span class="g-font-weight--600">Can be checked in by:</span><br />
													{% if row.KnownRelationships != null %}
														{% assign knownRelationships = row.KnownRelationships | FromJSON %}
														{% for kr in knownRelationships %}
															<div class="g-margin-y-10--xs" style="display: flex; flex-direction: row; align-items: center;">
																<p style="margin-right: 15px;">{{ kr.KRPersonName }}</p>
																<a onclick="confirmRemoveKR(this)" data-krid="{{kr.KRPersonId}}" title="Remove" class="se-action-btn g-color--dark g-radius--circle">
																	<i class="fas fa-user-times"></i>
																</a>

																<p style="display: none; padding-left: 30px; padding-right: 10px;" class="confirmRemoveKR-{{kr.KRPersonId}}">Are you sure?</p>

																<a style="display: none" onclick="removeGuestKR(this)" data-krid="{{kr.KRPersonId}}" data-guestguid="{{person.Guid}}" title="Yes" class="confirmRemoveKR-{{kr.KRPersonId}} se-action-btn g-padding-x-10--xs g-color--dark g-radius--circle g-bg-color-hover--black-opacity-lightest">
																	<i class="fas fa-check"></i>
																</a>
																<a style="display: none" onclick="cancelRemoveKR(this)" data-krid="{{kr.KRPersonId}}" title="Cancel" class="confirmRemoveKR-{{kr.KRPersonId}} se-action-btn g-padding-x-10--xs g-color--dark g-radius--circle g-bg-color-hover--black-opacity-lightest">
																	<i class="fas fa-times"></i>
																</a>
															</div>
														{% endfor %}
													{% else %}
														N/A
													{% endif %}
												</p>
											{% endif %}
										</div>
									[[ enditem ]]
								{[ endfaq ]}
							</div>
						</div>
					</div>
				</div>
				{% assign zIndexC = zIndexC | Minus:1 %}
			{% endfor %}
		</div>
    <div class="row g-padding-x-20--xs">
        <div class="col-md-12 g-padding-b-20--xs">
            <a class="btn btn-primary btn-xs" href="/MyAccount/Edit"> Add New Family Member</a>
        </div>
    </div>
</div>

<script>
    $(window).load(function() {
        var isoOptions = {
            percentPosition: true,
            itemSelector: '.isotope_item'
        };
        // Initialize Connection Opportunities Isotope
        var $grid = $('.isotope_wrap').isotope(isoOptions);
        // reveal all items after init
        var $items = $grid.find('.isotope_item');
        $grid.imagesLoaded( function() {
          // init Isotope after all images have loaded
          $grid.removeClass('hide-on-load').addClass('is-showing-items').isotope('layout');
        });
        $('.panel-collapse').on('shown.bs.collapse', function() {
          layoutIsotope();
        }).on('hidden.bs.collapse', function () {
          layoutIsotope();
        });
        function layoutIsotope() {
          $('.isotope_wrap').isotope('layout');
          console.log('ran isotope');
        }
    });
</script>
