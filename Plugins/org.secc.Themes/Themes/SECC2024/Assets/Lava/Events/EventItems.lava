<style>
.readmore_dates {
   transition: height 100ms;
   overflow: hidden;
   display: none;
}
.grid {
    display: grid;
    grid-template-columns: 100%;
}
@media (min-width: 48em) {
    .grid { grid-template-columns: 50% 50%; }
}
</style>

<div class="">

    {% if eventItemOccurrenceCount == 0 %}
    <div class="">
        <div class="text-center">
            <div style="border: 1px solid rgba(32, 30, 29, 0.50); padding: 20px; border-radius: 5px;">
                <p style="margin: 0px;">There are no events for this ministy at this time. Please try another campus or ministry.</p>
            </div>
        </div>
    </div>
    {% endif %}

    <div class="grid">
        {%- comment -%}Fluid: an unassigned limit: variable yields zero iterations (DotLiquid ignores it){%- endcomment -%}
        {%- if limitEvents == null or limitEvents == '' -%}{%- assign limitEvents = 1000000 -%}{%- endif -%}
        {% for eventItemList in EventItems limit:limitEvents %}
            {% comment %}
                One card stands for every occurrence of the event, so work out what the
                occurrences share before printing anything: campus, location, next date
                and childcare. The card shows a single value only when all of them agree.
            {% endcomment %}
            {% assign campusId = 0 %}
            {% assign hasAllCampusOccurrence = false %}
            {% assign multiCampus = false %}
            {% assign sharedLocation = '' %}
            {% assign multiLocation = false %}
            {% assign sharedDate = '' %}
            {% assign multiDate = false %}
            {% assign isRecurringEvent = false %}
            {% assign numOccurrences = eventItemList | Size %}
            {% assign childcareCount = 0 %}

            {% for eventItemOccurrence in eventItemList %}
                {% assign occurrenceCampusId = eventItemOccurrence.EventItemOccurrence.CampusId %}
                {% if occurrenceCampusId == null %}
                    {% assign hasAllCampusOccurrence = true %}
                {% elseif campusId == 0 %}
                    {% assign campusId = occurrenceCampusId %}
                {% elseif occurrenceCampusId != campusId %}
                    {% assign multiCampus = true %}
                {% endif %}

                {% assign occurrenceLocation = eventItemOccurrence.EventItemOccurrence.Location | Default:'' | Trim %}
                {% assign occurrenceDate = eventItemOccurrence.Date | Default:'' %}
                {% if forloop.first %}
                    {% assign sharedLocation = occurrenceLocation %}
                    {% assign sharedDate = occurrenceDate %}
                {% else %}
                    {% if occurrenceLocation != sharedLocation %}
                        {% assign multiLocation = true %}
                    {% endif %}
                    {% if occurrenceDate != sharedDate %}
                        {% assign multiDate = true %}
                    {% endif %}
                {% endif %}

                {% comment %}
                    Recurring = some campus's schedule still has at least two dates ahead.
                    Several campuses on one date is not recurring, and neither is a series
                    with only one date left.
                {% endcomment %}
                {% assign occurrenceICal = eventItemOccurrence.ICalendarContent | Default:'' %}
                {% if isRecurringEvent == false %}
                    {% if occurrenceICal contains 'RRULE' or occurrenceICal contains 'RDATE' %}
                        {% assign upcomingDateCount = occurrenceICal | DatesFromICal:2 | Size %}
                        {% if upcomingDateCount > 1 %}
                            {% assign isRecurringEvent = true %}
                        {% endif %}
                    {% endif %}
                {% endif %}

                {% if eventItemOccurrence.AttChildcareAvailable == 'True' %}
                    {% assign childcareCount = childcareCount | Plus:1 %}
                {% endif %}
            {% endfor %}

            {% comment %} An all-campus occurrence alongside a campus-specific one is still more than one campus. {% endcomment %}
            {% if hasAllCampusOccurrence == true and campusId != 0 %}
                {% assign multiCampus = true %}
            {% endif %}

            {% for eventItemOccurrence in eventItemList %}

                {% assign eventItem = eventItemOccurrence.EventItemOccurrence.EventItem %}
                {% comment %} **** Looping through the first occurance for each event item **** {% endcomment %}

                {% assign eventLinkURL = '' %}
                {% comment %} Setting Up Anchor Link for Details Page {% endcomment %}
                {% if eventItemOccurrence.DetailPage != null %}
                    {% assign eventLinkURL = eventItemOccurrence.DetailPage %}
                {% else %}
    			    {% assign urlSlug = eventItemOccurrence.URLSlugs | Default:'' | Split:'|' | First | Trim %}
    				{% if urlSlug != '' %}
    					{% assign eventLinkURL = DetailsPage | Replace:'/details','/' | Append:urlSlug %}
    				{% else %}
    					{% assign eventLinkURL = DetailsPage | Append:"?EventItemId=" | Append:eventItem.Id %}
    				{% endif %}
                {% endif %}

                {% comment %} Include Campus Id if it already exists in the URL {% endcomment %}
    			{% assign campusIdSize = pageParamCampusId | Size %}
                {% if pageParamCampusId > 0 %}
                    {% comment %} check for existing param, if not then show {% endcomment %}
                    {% if eventLinkURL contains '?' %}
                        {% assign eventLinkURL = eventLinkURL | Append:"&" %}
                    {% else %}
                        {% assign eventLinkURL = eventLinkURL | Append:"?" %}
                    {% endif %}
                    {% assign eventLinkURL = eventLinkURL | Append:"campusId=" | Append: pageParamCampusId %}
                {% endif %}
                <div class="event-calendar">
                    <div class="clearfix card">
                        <div class="caption g-padding-x-30--xs g-padding-t-30--xs g-margin-b-40--xs">

                            {% if eventItemOccurrence.Name != '' %}
                                <h3 class="g-font-family--secondary g-font-size-24--xs g-font-size-32--md g-padding-b-20--xs g-padding-b-25--md" style="margin-bottom: 5px;">
                                    {{ eventItemOccurrence.Name }}
                                </h3>
                            {% endif %}

                            {% if eventItemOccurrence.Summary != '' %}
                            <div class="readmore_dates">
                                {{eventItemOccurrence.Summary}}
                                <br />
                            </div>
                            {% endif %}


                            {% if multiCampus == true %}
                                    <p class="g-font-size-14-xs g-font-weight--300">
                                        <i class="fal fa-church"></i> Multiple Campuses
                                    </p>
                            {% elseif eventItemOccurrence.EventItemOccurrence.Campus.Name != null %}
                            <p class="g-font-size-14-xs g-font-weight--300">
                                <i class="fal fa-church"></i> {{eventItemOccurrence.EventItemOccurrence.Campus.Name}}
                            </p>
                            {% else %}
                            <p class="g-font-size-14-xs g-font-weight--300">
                                <i class="fal fa-church"></i> All Campuses
                            </p>
                            {% endif %}

                            {% comment %}
                                The block hands these over as stored values, not display text:
                                EventDatesHide is a Boolean ("True") and UseOnlyScheduleText is a
                                single-select whose stored value is "1" (shown as "Yes").
                                Hidden dates with no custom text drop the whole row, icon included.
                            {% endcomment %}
                            {% assign customDateText = eventItemOccurrence.CustomDateText | Default:'' | Trim %}
                            {% if customDateText != '' %}
                            <p class="g-font-size-14-xs g-font-weight--300">
                                <i class="fal fa-calendar"></i> {{ customDateText }}
                            </p>
                            {% elseif eventItemOccurrence.EventDatesHide != 'True' %}
                            {% assign useOnlyScheduleText = eventItemOccurrence.AttUseOnlyScheduleText %}
                            {% assign scheduleText = eventItemOccurrence.AttScheduleText | Default:'' | Trim %}
                            <p class="g-font-size-14-xs g-font-weight--300">
                                <i class="fal fa-calendar"></i>
                                {% if scheduleText != '' and useOnlyScheduleText == '1' %}
                                    {{ scheduleText }}
                                {% elseif scheduleText != '' and useOnlyScheduleText == 'Yes' %}
                                    {{ scheduleText }}
                                {% else %}
                                    {{ eventItemOccurrence.Date | Date: 'ddd, MMM dd'}}
                                {% endif %}
                                <br />
                                {% if multiDate == true %}
                                    <small class="uppercase g-padding-b-20--xs g-font-weight--700">Multiple Dates</small>
                                {% elseif isRecurringEvent == true %}
                                    <small class="uppercase g-padding-b-20--xs g-font-weight--700">Recurring Event</small>
                                {% endif %}
                            </p>
                            {% endif %}

                            <p class="g-font-size-14-xs g-font-weight--300">
                                <i class="fal fa-map-marker-alt"></i>
                                {% if eventItemOccurrence.CustomLocationText != null and eventItemOccurrence.CustomLocationText != '' -%}
                                    {{ eventItemOccurrence.CustomLocationText}}
                                {% elseif multiLocation == true %}
                                    {% comment %} Occurrences meet in different places, so no single room is right for everyone. {% endcomment %}
                                    {% if multiCampus == true %}
                                        Multiple <br />Campuses
                                    {% else %}
                                        Multiple <br />Locations
                                    {% endif %}
                                {% elseif sharedLocation != '' %}
                                    {{ sharedLocation }}
                                {% elseif multiCampus == true %}
                                    Multiple <br />Campuses
                                {% elseif eventItemOccurrence.EventItemOccurrence.Campus.Name != null %}
                                    {{eventItemOccurrence.EventItemOccurrence.Campus.Name}} <br />Campus
                                {% else %}
                                    All <br />Campuses
                                {% endif %}
                            </p>

                            <!-- ChildCare -->
                            {% if childcareCount > 0 %}
                                <p class="g-font-size-14-xs g-font-weight--300">
                                    <i class="fal fa-child"></i> Children's Programming{% if childcareCount < numOccurrences %} (some sessions){% endif %}
                                </p>
                            {% endif %}
                        </div><!-- END: caption -->

                        <div class="text-center g-margin-b-25--xs g-margin-b-30--md g-margin-x-10--xs" style="display:flex; align-content:space-between;">
                            <div class="" style="flex:1 1 0;">
                                {[ sebutton title:'More Info' href:'{{ eventLinkURL }}' type:'light' target:'' addclasses:'g-width-90-percent--xs se-btn--sm' theme:'2024' ]}
                            </div>
                        </div>
                    </div>
                </div><!-- END: isotope_item -->
                {% comment %} **** Only need the first occurance, so break away. **** {% endcomment %}
                {% break %}
            {% endfor %}
        {% endfor %}

    </div><!-- END: isotope_wrap -->

</div><!-- END: bootstrap container -->

{% comment %}
**********************************************************************************
****** The code below will need to be included if this file isn't included *******
******  anywhere else (such as 'FeaturedEvents.lava' or 'AllEvents.lava')  *******
**********************************************************************************
